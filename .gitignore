# Node / Express backend.
#
# This file used to be the Expo template, copied from the app repo — it ignored `/android`, `/ios`,
# `web-build/` and `.expo/`, none of which this repo has ever produced. It did cover `.env` and
# `node_modules/`, so nothing was ever at risk; it just described a different project.

# dependencies
node_modules/

# environment — never commit real secrets. `.env.example` is the tracked template and must not be
# caught by these; when adding a variable, add it there with a placeholder too.
.env
.env.*
!.env.example

# credentials and certificates
*.pem
*.key
*.p12
*.pfx

# logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# test and coverage output
coverage/
.nyc_output/

# local backup artefacts, if BACKUP_DIR is ever pointed inside the repo instead of /tmp
mongo_backup_*/
*.tar.gz

# editors
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
