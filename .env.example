# Copy this file to .env and fill in your own values
# NEVER commit .env to git

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_128_char_random_hex
REFRESH_TOKEN_SECRET=replace_with_different_128_char_random_hex

# AWS S3 (for profile photo uploads)
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=your_bucket_name

# Anthropic (optional — only needed for AI spending insights)
ANTHROPIC_API_KEY=

# Comma-separated allowed origins, e.g. https://app.yourdomain.com,https://yourdomain.com
ALLOWED_ORIGINS=https://app.yourdomain.com

# S3 bucket name for nightly database backups (separate from profile photo bucket)
BACKUP_S3_BUCKET=your-backup-bucket-name

# SMTP — for password reset and email verification emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password

# Deep link base URL used in password reset / verification emails
APP_DEEP_LINK=expensetrackerapp://
